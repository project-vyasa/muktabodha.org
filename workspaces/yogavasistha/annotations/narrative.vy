`title [Yogavasistha Narrative Frames]

// Outer frame: Vālmīki's primary discourse to Rāma (covers the whole work).
`frame { id="narrative.yv_primary" type="NarrativeFrame" name="Primary Discourse (Vālmīki → Rāma)" } [

    // Book 1, Chapter 1: Sutīkṣṇāgastya-saṃvāda — dialogue plus embedded itihāsa.
    `frame { id="narrative.1.1.sutikshna-agastya" type="NarrativeFrame" name="Sutīkṣṇāgastya-saṃvāda" } [

        `annotate 1:1:4..1:1:6 [
            `sutikshna.uvaca
        ]

        `annotate 1:1:7..1:1:8 [
            `agastya.uvaca
        ]

        `annotate 1:1:9..1:1:11 [
            `agastya.uvaca
        ]

        `annotate 1:1:12..1:1:13 [
            `agnivesya.uvaca
        ]

        `annotate 1:1:14..1:1:16 [
            `karunya.uvaca
        ]

        `annotate 1:1:17 [
            `agastya.uvaca
        ]

        `annotate 1:1:18 [
            `agnivesya.uvaca
        ]

        // Suruci ↔ devadūta exchange within the embedded itihāsa.
        `annotate 1:1:22 [
            `suruci.uvaca
        ]

        `annotate 1:1:23 [
            `devaduta.uvaca
        ]

        `annotate 1:1:26 [
            `suruci.uvaca
        ]

        `annotate 1:1:32 [
            `devaduta.uvaca
        ]

        `annotate 1:1:36 [
            `devaduta.uvaca
        ]

        // Vālmīki introduces the Rāma narrative to the king (Ariṣṭanemi frame).
        `annotate 1:1:52 [
            `valmiki.uvaca
        ]

        `annotate 1:1:55 [
            `valmiki.uvaca
        ]

        `annotate 1:1:57 [
            `valmiki.uvaca
        ]

        `annotate 1:1:61 [
            `bhrgu.uvaca
        ]
    ]
]
